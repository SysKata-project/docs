# Local configuration template only; no runnable service launcher exists yet.
# Copy to a Git-ignored .env when implementing local setup.
# These illustrative inputs must be mapped by the launcher to each service.
# Supply local values for every blank field; never commit the populated file.

SYSKATA_APP_DB_NAME=syskata
SYSKATA_APP_DB_USER=syskata_app
SYSKATA_APP_DB_PASSWORD=

SYSKATA_IDENTITY_DB_NAME=syskata_identity
SYSKATA_IDENTITY_DB_USER=syskata_identity
SYSKATA_IDENTITY_DB_PASSWORD=

SYSKATA_KEYCLOAK_ADMIN_USER=
SYSKATA_KEYCLOAK_ADMIN_PASSWORD=
SYSKATA_OIDC_ISSUER_URL=
SYSKATA_OIDC_API_AUDIENCE=
SYSKATA_OIDC_MOBILE_CLIENT_ID=

# Lab connectivity is pending the feasibility and API contract issues.
SYSKATA_LAB_SERVICE_URL=
SYSKATA_LAB_SERVICE_CREDENTIAL=
